{
  "hosting": {
    "public": "out",
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/opengraph-image",
        "headers": [{ "key": "Content-Type", "value": "image/png" }]
      },
      {
        "source": "/admin/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
      }
    ]
  }
}
